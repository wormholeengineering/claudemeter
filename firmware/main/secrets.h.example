/*
 * Copie para secrets.h (mesmo diretório) e preencha.
 * secrets.h está no .gitignore — NUNCA versione valores reais.
 * Estes valores são compilados no firmware; o .bin de OTA só é servido
 * por trás do Cloudflare Access.
 */
#pragma once

// Redes Wi-Fi tentadas em ordem. Para trocar a senha sem abrir o aparelho:
// publique um OTA com a rede antiga + a nova, troque no roteador e, depois,
// publique outro OTA removendo a antiga.
#define WIFI_NETWORKS { \
    { "sua-rede", "sua-senha" }, \
}

// Senha WPA2 (8–63 caracteres) da rede de recuperação "ClaudeMeter-XXXX",
// aberta só após 15 min sem conseguir conectar a nenhuma rede acima.
#define RECOVERY_AP_PASS "troque-esta-senha"

// Cloudflare Access Service Token (Zero Trust → Access → Service Auth).
// Deixe vazio para não enviar os headers CF-Access-*.
#define CF_ACCESS_CLIENT_ID     ""
#define CF_ACCESS_CLIENT_SECRET ""

// Opcional — sobrescreve o host padrão (/usage e /firmware/ ficam sob ele)
// #define WATCH_BASE_URL       "https://watch.jimmylab.com.br"
