# Copie para .env (fora do Git) em /docker/apps/claude-meter

TZ=America/Porto_Velho

# Intervalo mínimo entre scrapes do claude.ai (segundos). Padrão: 300 (5 min)
# SCRAPE_INTERVAL_SEC=300

# Saldo extra manual (fallback se não vier de prepaid/credits)
# CLAUDE_EXTRA_BALANCE=12.50

# Opcional — permite admin fora do loopback com "Authorization: Bearer <token>".
# Vazio = admin só via docker exec (recomendado). Gere com: openssl rand -hex 32
# ADMIN_TOKEN=
